# Copier ce fichier en .env.local (ignoré par Git) et remplir les valeurs.
# Supabase : Project Settings, puis API (ou Data API).

# Adresse du projet et clé PUBLIQUE (« anon » ou « publishable »).
# Elles finissent dans l'app, c'est normal : la sécurité repose sur les règles par ligne.
# Ne JAMAIS mettre ici la clé service_role ou secret.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Deux comptes de test, uniquement pour npm run test:rls sur le PC.
# À créer dans Supabase : Authentication, Users, Add user, avec « Auto Confirm User ».
# Ces variables ne commencent pas par EXPO_PUBLIC_ : elles ne vont jamais dans l'app.
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
